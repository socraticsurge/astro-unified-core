# Local design mockups (24MB) — not part of the deployed app
design/
prototypes/

# Production database recovery artifacts must never enter a build context.
backups/
*.db
*.db-wal
*.db-shm
*.db-info

# Repo documentation — not needed at runtime
docs/
CHANGELOG.md
AGENTS.md

# Tests — not needed in the production bundle
**/__tests__/
**/*.test.ts
**/*.test.tsx
tests/
test-results/
playwright-report/
playwright.config.ts
vitest.config.ts
vitest.setup.ts

# Local framework output is rebuilt remotely.
.next/

# AI agent scratch directories
.claude/
.jules/
.cursor/
.aider/

# Sidecar artifacts that don't belong in the web app deployment
# (now also gitignored — kept here as a safety net)
public/data/
