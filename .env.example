# Required — copy this file to .env.local and fill in real values

# Turso (LibSQL) database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI providers
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Astrological computation sidecar (internal service, never expose publicly)
# Preview/Production require HTTPS. Local HTTP is accepted only for an exact
# localhost, 127.0.0.1, or [::1] loopback URL.
DASHAFLOW_SIDECAR_URL=https://your-sidecar.vercel.app
# Required 32–256 printable non-space ASCII bearer credential for every
# sidecar compute call. Only the sidecar health route is unauthenticated.
DASHAFLOW_SIDECAR_TOKEN=generate-a-random-secret-at-least-32-characters

# Guest route activation (server-only; never use NEXT_PUBLIC_ or VITE_).
# Local development defaults to enabled while these are omitted. Vercel Preview
# and Production require the exact value `true`; add them there only after the
# corresponding licensing/provider release gates are approved.
# GUEST_BIRTH_PROFILE_ENABLED=true
# GUEST_ELECTION_CHART_ENABLED=true

# Guest place search, plus the explicit authenticated migration gate. Public
# Nominatim guest search fails closed unless that migration is also enabled so
# every deployed caller shares one application-wide provider pool.
# Local development does not call public Nominatim; use unit/browser fixtures.
# The initial Production posture reuses it through `nominatim-public`, one
# submit-only guest request, an exclusive Turso send lease, process caching, an
# identifying User-Agent, and OpenStreetMap attribution. Existing signed-in
# Production signed-in profile geocoding keeps its legacy path until
# AUTH_PROFILE_MANAGED_GEOCODER_ENABLED is exactly true.
# Supported values: nominatim-public, locationiq-eu, locationiq-us, geoapify.
# No LocationIQ, Geoapify, Upstash, or Redis account is needed for the initial
# Nominatim release; the commercial values are dormant alternatives only.
# GEOCODER_PROVIDER=nominatim-public
# GEOCODER_API_KEY is required only for LocationIQ or Geoapify.
# Required canonical integer before any deployed managed provider process-cache
# miss can start: 1-1000 for public Nominatim, 1-1500 for dormant commercial
# adapters. The first reservation each UTC day
# persists this value in the shared provider row; a same-day Preview/Production
# mismatch fails closed. Begin conservatively and keep it within the owner-
# approved provider policy. Begin public Nominatim at 1000.
# GEOCODER_DAILY_REQUEST_LIMIT=1000
# AUTH_PROFILE_MANAGED_GEOCODER_ENABLED=true  # required with deployed public Nominatim

# Preview/Production-required HMAC secret for Turso-backed identity/fleet
# counters. Use 32-256 printable non-space ASCII characters and never prefix
# with NEXT_PUBLIC_. Turso stores only deployment-scoped HMAC digests and
# integer count/expiry fields; raw IPs, user IDs, place text/results, birth
# details, and coordinates are never written to limiter tables. The provider
# quota row is a non-personal aggregate shared across Preview and Production,
# so the intended topology uses the same physical Turso DB whenever both
# environments are active against one provider-policy pool. Verify DB identity
# before activation; matching variable names alone do not prove it. Code-owned
# attempt caps per anchored 24-hour window are: all guest routes 2,000 Preview / 10,000
# Production, and managed authenticated geocoding 500 Preview / 2,500
# Production. Capacity is reserved before user/fleet/client rows and is not
# refunded when a later route-specific guard rejects. Before activation, use
# db:provision-rate-limits for each exact deployment target; runtime readiness
# is read-only and will fail closed rather than creating missing objects.
RATE_LIMIT_HMAC_SECRET=generate-a-random-secret-at-least-32-characters

# Admin access — comma-separated list of Google account emails
ADMIN_EMAILS=you@example.com
