# Required — copy this file to .env.local and fill in real values

# Turso (LibSQL) database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI providers
GOOGLE_GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Astrological computation sidecar (internal service, never expose publicly)
# Preview/Production require HTTPS. Local HTTP is accepted only for an exact
# localhost, 127.0.0.1, or [::1] loopback URL.
DASHAFLOW_SIDECAR_URL=https://your-sidecar.vercel.app
# 32–256 printable non-space ASCII bearer credential for server-to-server calls
DASHAFLOW_SIDECAR_TOKEN=generate-a-random-secret-at-least-32-characters

# Guest route activation (server-only; never use NEXT_PUBLIC_ or VITE_).
# Local development defaults to enabled while these are omitted. Vercel Preview
# and Production require the exact value `true`; add them there only after the
# corresponding licensing/provider release gates are approved.
# GUEST_BIRTH_PROFILE_ENABLED=true
# GUEST_ELECTION_CHART_ENABLED=true

# Guest place search, plus the separately gated authenticated migration.
# Optional locally: the fixed public Nominatim default is process-limited and
# cached. Guest Preview/Production search requires one fixed managed-provider
# adapter and server-only key. Existing signed-in profile geocoding keeps its
# legacy path until AUTH_PROFILE_MANAGED_GEOCODER_ENABLED is exactly true;
# enable that flag only after provider, Redis, quota, privacy, and journey QA.
# Supported values: locationiq-eu, locationiq-us, geoapify. The adapter owns
# the endpoint; operator-supplied geocoder base URLs are unsupported.
# GEOCODER_PROVIDER=locationiq-eu
# GEOCODER_API_KEY=replace-with-the-selected-provider-server-key
# AUTH_PROFILE_MANAGED_GEOCODER_ENABLED=true

# Preview/Production-required shared abuse control for all guest calculations,
# enabled authenticated managed geocoding, and the 24-hour normalized result
# cache. Vercel's Upstash Redis Marketplace integration injects these values.
# A complete legacy KV_* pair is accepted only as a compatibility fallback;
# never mix URL/token namespaces.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-standard-server-only-rest-token
# KV_REST_API_URL=https://your-compatible-database.example
# KV_REST_API_TOKEN=your-standard-server-only-rest-token

# Admin access — comma-separated list of Google account emails
ADMIN_EMAILS=you@example.com
