# Required — copy this file to .env.local and fill in real values

# Turso (LibSQL) database
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-token

# NextAuth
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI providers
GROQ_API_KEY=your-groq-api-key

# Astrological computation sidecar (internal service, never expose publicly)
DASHAFLOW_SIDECAR_URL=https://your-sidecar.vercel.app

# Telugu Calendar Utilities API (server-only; token must be 32+ characters)
PANCHANGAM_API_URL=https://your-panchangam-api.vercel.app
PANCHANGAM_API_TOKEN=your-environment-specific-service-token

# Deployment-controlled public-home switch. Leave disabled outside the exact
# isolated Gate 8 staging dependency graph.
UNIFIED_RELEASE_MODE=legacy

# Optional local owner-review harness. Never enable this in a deployment. Code
# additionally requires NODE_ENV=development, localhost:3001, the synthetic
# staging Turso host, and a localhost Telugu API before it can activate.
ASTRO_LOCAL_REVIEW=disabled
ASTRO_STAGING_AUTH=disabled

# Admin access — comma-separated list of Google account emails
ADMIN_EMAILS=you@example.com
